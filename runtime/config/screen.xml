<!DOCTYPE params SYSTEM "../tgf/params.dtd">

<params name="screen" type="params" mode="mw">

  <section name="Screen Properties">
    <attnum name="x" val="1280"/>
    <attnum name="y" val="720"/>
    <attnum name="bpp" val="24"/>
    <attstr name="fullscreen" in="yes,no" val="no"/>
    <attnum name="gamma" val="2.0"/>
  </section>

  <section name="Menu Font">
    <attstr name="name"        val="b5.glf"/>
    <attnum name="size big"    val="36"/>
    <attnum name="size large"  val="26"/>
    <attnum name="size medium" val="20"/>
    <attnum name="size small"  val="16"/>
  </section>

  <section name="Console Font">
    <attstr name="name"        val="b7.glf"/>
    <attnum name="size big"    val="30"/>
    <attnum name="size large"  val="22"/>
    <attnum name="size medium" val="14"/>
    <attnum name="size small"  val="11"/>
  </section>

  <section name="Digital Font">
    <attstr name="name"        val="digital.glf"/>
    <attnum name="size big"    val="14"/>
  </section>

  <section name="Menu Colors">
    <section name="colors">
      <!-- Deep navy background for a modern dark racing theme -->
      <section name="background">
	<attnum name="red" val="0.04"/>
	<attnum name="green" val="0.05"/>
	<attnum name="blue" val="0.10"/>
	<attnum name="alpha" val="0.95"/>
      </section>
      <!-- Bright white title -->
      <section name="title">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="1.0"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Electric blue semi-transparent highlight for focused button bg -->
      <section name="background focused button">
	<attnum name="red" val="0.0"/>
	<attnum name="green" val="0.40"/>
	<attnum name="blue" val="0.85"/>
	<attnum name="alpha" val="0.55"/>
      </section>
      <!-- Brighter blue for pressed/clicked button bg -->
      <section name="background pushed button">
	<attnum name="red" val="0.0"/>
	<attnum name="green" val="0.50"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="0.80"/>
      </section>
      <!-- Subtle dark fill for normal button bg -->
      <section name="background enabled button">
	<attnum name="red" val="0.08"/>
	<attnum name="green" val="0.09"/>
	<attnum name="blue" val="0.18"/>
	<attnum name="alpha" val="0.50"/>
      </section>
      <!-- Very dim fill for disabled button bg -->
      <section name="background disabled button">
	<attnum name="red" val="0.05"/>
	<attnum name="green" val="0.05"/>
	<attnum name="blue" val="0.10"/>
	<attnum name="alpha" val="0.25"/>
      </section>
      <!-- Bright white text on focused button (replaces harsh red) -->
      <section name="focused button">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="1.0"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Near-white text for clicked/pushed button -->
      <section name="pushed button">
	<attnum name="red" val="0.90"/>
	<attnum name="green" val="0.95"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Silver-blue text for normal enabled button (replaces yellow) -->
      <section name="enabled button">
	<attnum name="red" val="0.75"/>
	<attnum name="green" val="0.85"/>
	<attnum name="blue" val="0.95"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Muted gray for disabled button text -->
      <section name="disabled button">
	<attnum name="red" val="0.35"/>
	<attnum name="green" val="0.38"/>
	<attnum name="blue" val="0.45"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Transparent scroll list background -->
      <section name="background scroll list">
	<attnum name="red" val="0.05"/>
	<attnum name="green" val="0.06"/>
	<attnum name="blue" val="0.12"/>
	<attnum name="alpha" val="0.60"/>
      </section>
      <!-- Silver-blue list item text (replaces yellow) -->
      <section name="scroll list">
	<attnum name="red" val="0.75"/>
	<attnum name="green" val="0.85"/>
	<attnum name="blue" val="0.95"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Electric blue selection highlight -->
      <section name="background selected scroll list">
	<attnum name="red" val="0.0"/>
	<attnum name="green" val="0.40"/>
	<attnum name="blue" val="0.85"/>
	<attnum name="alpha" val="0.80"/>
      </section>
      <!-- White text on selected list item (replaces harsh red) -->
      <section name="selected scroll list">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="1.0"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Near-white labels -->
      <section name="label">
	<attnum name="red" val="0.92"/>
	<attnum name="green" val="0.94"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Muted blue-gray tooltip text -->
      <section name="tip">
	<attnum name="red" val="0.55"/>
	<attnum name="green" val="0.65"/>
	<attnum name="blue" val="0.80"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Light electric blue mouse cursor primary -->
      <section name="mouse 1">
	<attnum name="red" val="0.55"/>
	<attnum name="green" val="0.80"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Darker blue mouse cursor outline -->
      <section name="mouse 2">
	<attnum name="red" val="0.10"/>
	<attnum name="green" val="0.30"/>
	<attnum name="blue" val="0.65"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Soft cyan for help key labels (replaces harsh yellow) -->
      <section name="help key">
	<attnum name="red" val="0.30"/>
	<attnum name="green" val="0.80"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Soft green for help descriptions (replaces harsh cyan) -->
      <section name="help description">
	<attnum name="red" val="0.60"/>
	<attnum name="green" val="0.90"/>
	<attnum name="blue" val="0.65"/>
	<attnum name="alpha" val="1.0"/>
      </section>
    </section>
  </section>

</params>
