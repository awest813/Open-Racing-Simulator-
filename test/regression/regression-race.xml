<?xml version="1.0" encoding="UTF-8"?>
<!--
  Headless regression race — AI drivers only (required for torcs -r).
  Track: forza | 10 laps | fixed robot grid for reproducibility.
-->
<!DOCTYPE params SYSTEM "../../runtime/config/params.dtd">

<params name="Regression Race" type="param" mode="mw">

  <section name="Header">
    <attstr name="name" val="Regression Race"/>
    <attstr name="description" val="Headless regression: forza, 10 laps, fixed AI grid"/>
    <attnum name="priority" val="1"/>
  </section>

  <section name="Tracks">
    <attnum name="maximum number" val="1"/>
    <section name="1">
      <attstr name="name" val="forza"/>
      <attstr name="category" val="road"/>
    </section>
  </section>

  <section name="Races">
    <section name="1">
      <attstr name="name" val="Regression"/>
    </section>
  </section>

  <section name="Regression">
    <attnum name="laps" val="10"/>
    <attstr name="type" val="race"/>
    <attstr name="starting order" val="drivers list"/>
    <attstr name="restart" val="no"/>
    <attstr name="display mode" val="results only"/>
    <attstr name="display results" val="no"/>

    <section name="Starting Grid">
      <attnum name="rows" val="2"/>
      <attnum name="distance to start" val="25"/>
      <attnum name="distance between columns" val="20"/>
      <attnum name="offset within a column" val="10"/>
      <attnum name="initial speed" val="0"/>
      <attnum name="initial height" val="0.2"/>
    </section>
  </section>

  <section name="Drivers">
    <attnum name="maximum number" val="4"/>
    <attstr name="focused module" val="berniw"/>
    <attnum name="focused idx" val="4"/>

    <section name="1">
      <attnum name="idx" val="4"/>
      <attstr name="module" val="berniw"/>
    </section>
    <section name="2">
      <attnum name="idx" val="5"/>
      <attstr name="module" val="olethros"/>
    </section>
    <section name="3">
      <attnum name="idx" val="6"/>
      <attstr name="module" val="inferno"/>
    </section>
    <section name="4">
      <attnum name="idx" val="7"/>
      <attstr name="module" val="bt"/>
    </section>
  </section>

</params>
