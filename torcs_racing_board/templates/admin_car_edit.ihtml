<table class="embedded" cellspacing="0">
	<tr>
		<td class="border contentbordercolor">

			<h3>Edit Car Data</h3>
			<p>
				Here you can edit existing car data. If the page comes up again after submission,
				there must be errors, please correct them and submit again. The image size must
				be exactly 300x379.
			</p>

			<form method="post" enctype="multipart/form-data" action="{PC_CREATECARPAGE}" class="embedded">
				<input type="hidden" name="car_id" value="{PC_CAR_ID}">
				<table class="text14" cellspacing="0">
					<tr>
						<td class="admincol1 filledlist">
							<label for="car_name">Name:</label>
						</td>
						<td class="admincol2 filledlist">
							<input id="car_name" type="text" name="car_name" size="40" maxlength="40" value="{PC_CAR_NAME}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_author">Author:</label>
						</td>
						<td class="filledlist">
							<input id="car_author" type="text" name="car_author" size="40" maxlength="40" value="{PC_CAR_AUTHOR}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_mass">Mass [kg]:</label>
						</td>
						<td class="filledlist">
							<input id="car_mass" type="text" name="car_mass" size="10" maxlength="10" value="{PC_CAR_MASS}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_maxfuel">Max. Fuel [kg]:</label>
						</td>
						<td class="filledlist">
							<input id="car_maxfuel" type="text" name="car_maxfuel" size="10" maxlength="10" value="{PC_CAR_TANK}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_cxa">Cx*A [m*m]:</label>
						</td>
						<td class="filledlist">
							<input id="car_cxa" type="text" name="car_cxa" size="10" maxlength="10" value="{PC_CAR_CXA}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_power">Max. Power [kW]:</label>
						</td>
						<td class="filledlist">
							<input id="car_power" type="text" name="car_power" size="10" maxlength="10" value="{PC_CAR_POWER}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_length">Length [m]:</label>
						</td>
						<td class="filledlist">
							<input id="car_length" type="text" name="car_length" size="10" maxlength="10" value="{PC_CAR_LENGTH}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_width">Width [m]:</label>
						</td>
						<td class="filledlist">
							<input id="car_width" type="text" name="car_width" size="10" maxlength="10" value="{PC_CAR_WIDTH}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_type">Drivetrain:</label>
						</td>
						<td class="filledlist">
							<select id="car_type" name="car_type" size="1">
								<option {PC_CAR_RWD} value="rwd">Rear Wheel Driven</option>
								<option {PC_CAR_FWD} value="fwd">Front Wheel Driven</option>
								<option {PC_CAR_4WD} value="4wd">All Wheels Driven</option>
							</select>
						</td>
					</tr>


					<tr>
						<td class="filledlist" align="left" valign="top">
							<label for="car_description">Description:</label>
						</td>
						<td class="filledlist">
							<textarea id="car_description" name="car_description" rows="6" class="admincol2">{PC_CAR_DESCRIPTION}</textarea>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="car_image">Image (*.jpg):</label>
						</td>
						<td class="filledlist">
							<input id="car_image" name="car_image" type="file" size="60" maxlength="50000" accept="image/jpeg" value="{PC_CAR_IMG_SRC}"/>
						</td>
					</tr>
				</table>

				<table class="text14" cellspacing="0">
					<tr>
						<td class="filledlist">
							<input type="submit" name="car_submit" value="Submit Car">
						</td>
					</tr>
				</table>
			</form>
		</td>
	</tr>
</table>











