<table class="embedded" cellspacing="0">
	<tr>
		<td class="border contentbordercolor">

			<h3>Create a New Event</h3>
			<p>
				Here you can create a new event. An event is a container for multiple races, e.g. a
				championship. If the page comes up again after submission,
				there must be errors, please correct them and submit again.
			</p>

			<form method="post" enctype="multipart/form-data" action="{PC_CREATEEVENTPAGE}" class="embedded">
				<table class="text14" cellspacing="0">
					<tr>
						<td class="admincol1 filledlist">
							<label for="event_name">Name:</label>
						</td>
						<td class="admincol2 filledlist">
							<input id="event_name" type="text" name="event_name" size="40" maxlength="40" value="{PC_EVENT_NAME}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist" align="left" valign="top">
							<label for="event_description">Description:</label>
						</td>
						<td class="filledlist">
							<textarea id="event_description" name="event_description" rows="6" class="admincol2">{PC_EVENT_DESCRIPTION}</textarea>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="event_signin_start">Sign-in start:</label>
						</td>
						<td class="admincol2 filledlist">
							<input id="event_signin_start" type="text" name="event_signin_start" size="20" maxlength="19" value="{PC_EVENT_SIGNIN_START}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="event_signin_end">Sign-in end:</label>
						</td>
						<td class="admincol2 filledlist">
							<input id="event_signin_end" type="text" name="event_signin_end" size="20" maxlength="19" value="{PC_EVENT_SIGNIN_END}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="event_start">Start date:</label>
						</td>
						<td class="admincol2 filledlist">
							<input id="event_start" type="text" name="event_start" size="20" maxlength="19" value="{PC_EVENT_START}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="event_end">End date:</label>
						</td>
						<td class="admincol2 filledlist">
							<input id="event_end" type="text" name="event_end" size="20" maxlength="19" value="{PC_EVENT_END}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist" align="left" valign="top">
							<label for="event_cars">Cars:</label>
						</td>
						<td class="filledlist">
							<select id="event_cars" name="event_cars[]" size="6" multiple="multiple">
							<!-- BEGIN row -->
								<option {PC_EVENT_CAR_SEL} value="{PC_EVENT_CAR_ID}">{PC_EVENT_CAR_NAME}</option>
							<!-- END row -->
							</select>
						</td>
					</tr>

					<tr>
						<td class="filledlist" align="left" valign="top">
							<label for="event_maxteams">Max. Teams:</label>
						</td>
						<td class="filledlist">
							<select id="event_maxteams" name="event_maxteams" size="1">
							<!-- BEGIN maxtrow -->
								<option {PC_EVENT_MAXTEAM_SEL} value="{PC_EVENT_MAXTEAM_NB}">{PC_EVENT_MAXTEAM_NB}</option>
							<!-- END maxtrow -->
							</select>
						</td>
					</tr>

					<tr>
						<td class="filledlist" align="left" valign="top">
							Pointssystem:
						</td>
						<td class="filledlist">
							<select name="event_pointsystem" size="1">
							<!-- BEGIN pointsrow -->
								<option {PC_EVENT_POINTSYSTEM_SEL} value="{PC_EVENT_POINTSYSTEM_NB}">{PC_EVENT_POINTSYSTEM_NAME}</option>
							<!-- END pointsrow -->
							</select>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="event_rules">Rules (*.html):</label>
						</td>
						<td class="filledlist">
							<input id="event_rules" name="event_rules" type="file" size="60" maxlength="50000" accept="text/html"/>
						</td>
					</tr>
				</table>

				<table class="text14" cellspacing="0">
					<tr>
						<td class="filledlist">
							<input type="submit" name="event_submit" value="Submit Event">
						</td>
					</tr>
				</table>
			</form>
		</td>
	</tr>
</table>
