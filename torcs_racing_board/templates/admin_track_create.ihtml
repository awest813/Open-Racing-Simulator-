<table class="embedded" cellspacing="0">
	<tr>
		<td class="border contentbordercolor">

			<h3>Enter a New Track</h3>
			<p>
				Here you can enter a new track. If the page comes up again after submission,
				there must be errors, please correct them and submit again. The image size must
				be exactly 256x256.
			</p>

			<form method="post" enctype="multipart/form-data" action="{PC_CREATETRACKPAGE}" class="embedded">
				<table class="text14" cellspacing="0">
					<tr>
						<td class="admincol1 filledlist">
							<label for="track_name">Name:</label>
						</td>
						<td class="admincol2 filledlist">
							<input type="text" id="track_name" name="track_name" size="40" maxlength="40" value="{PC_TRACK_NAME}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_internalname">Internal name:</label>
						</td>
						<td class="filledlist">
							<input type="text" id="track_internalname" name="track_internalname" size="40" maxlength="40" value="{PC_TRACK_INTERNALNAME}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_author">Author:</label>
						</td>
						<td class="filledlist">
							<input type="text" id="track_author" name="track_author" size="40" maxlength="40" value="{PC_TRACK_AUTHOR}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_nbpits">#Pits:</label>
						</td>
						<td class="filledlist">
							<input type="text" id="track_nbpits" name="track_nbpits" size="10" maxlength="10" value="{PC_TRACK_NBPITS}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_width">Width [m]:</label>
						</td>
						<td class="filledlist">
							<input type="text" id="track_width" name="track_width" size="10" maxlength="10" value="{PC_TRACK_WIDTH}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_length">Length [m]:</label>
						</td>
						<td class="filledlist">
							<input type="text" id="track_length" name="track_length" size="10" maxlength="10" value="{PC_TRACK_LENGTH}"/>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_type">Type:</label>
						</td>
						<td class="filledlist">
							<select id="track_type" name="track_type" size="1">
								<option {PC_TRACK_TYPE_DIRT} value="dirt">dirt</option>
								<option {PC_TRACK_TYPE_OVAL} value="oval">oval</option>
								<option {PC_TRACK_TYPE_ROAD} value="road">road</option>
							</select>
						</td>
					</tr>


					<tr>
						<td class="filledlist" align="left" valign="top">
							<label for="track_description">Description:</label>
						</td>
						<td class="filledlist">
							<textarea id="track_description" name="track_description" rows="6" class="admincol2">{PC_TRACK_DESCRIPTION}</textarea>
						</td>
					</tr>

					<tr>
						<td class="filledlist">
							<label for="track_image">Map (*.jpg):</label>
						</td>
						<td class="filledlist">
							<input id="track_image" name="track_image" type="file" size="60" maxlength="50000" accept="image/jpeg" value="{PC_TRACK_IMG_SRC}"/>
						</td>
					</tr>
				</table>

				<table class="text14" cellspacing="0">
					<tr>
						<td class="filledlist">
							<input type="submit" name="track_submit" value="Submit Track">
						</td>
					</tr>
				</table>
			</form>
		</td>
	</tr>
</table>
