<!DOCTYPE params SYSTEM "../tgf/params.dtd">

<params name="screen" type="params" mode="mw">

  <section name="Screen Properties">
    <attnum name="x" val="1280"/>
    <attnum name="y" val="720"/>
    <attnum name="bpp" val="24"/>
    <attstr name="fullscreen" in="yes,no" val="no"/>
    <attnum name="gamma" val="2.0"/>
  </section>

  <section name="Menu Font">
    <attstr name="name"        val="b5.glf"/>
    <attnum name="size big"    val="36"/>
    <attnum name="size large"  val="26"/>
    <attnum name="size medium" val="20"/>
    <attnum name="size small"  val="16"/>
  </section>

  <section name="Console Font">
    <attstr name="name"        val="b7.glf"/>
    <attnum name="size big"    val="30"/>
    <attnum name="size large"  val="22"/>
    <attnum name="size medium" val="14"/>
    <attnum name="size small"  val="11"/>
  </section>

  <section name="Digital Font">
    <attstr name="name"        val="digital.glf"/>
    <attnum name="size big"    val="14"/>
  </section>

  <section name="Menu Colors">
    <section name="colors">
      <!-- True deep black background -->
      <section name="background">
	<attnum name="red" val="0.02"/>
	<attnum name="green" val="0.02"/>
	<attnum name="blue" val="0.04"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Platinum white title -->
      <section name="title">
	<attnum name="red" val="0.96"/>
	<attnum name="green" val="0.96"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Amber glow for focused button background -->
      <section name="background focused button">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="0.55"/>
	<attnum name="blue" val="0.0"/>
	<attnum name="alpha" val="0.18"/>
      </section>
      <!-- Brighter amber for pushed button background -->
      <section name="background pushed button">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="0.55"/>
	<attnum name="blue" val="0.0"/>
	<attnum name="alpha" val="0.45"/>
      </section>
      <!-- Near-black charcoal for normal button background -->
      <section name="background enabled button">
	<attnum name="red" val="0.06"/>
	<attnum name="green" val="0.07"/>
	<attnum name="blue" val="0.12"/>
	<attnum name="alpha" val="0.55"/>
      </section>
      <!-- Very dim for disabled button background -->
      <section name="background disabled button">
	<attnum name="red" val="0.03"/>
	<attnum name="green" val="0.03"/>
	<attnum name="blue" val="0.06"/>
	<attnum name="alpha" val="0.20"/>
      </section>
      <!-- Pure white for focused button text -->
      <section name="focused button">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="1.0"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Warm near-white for pushed button text -->
      <section name="pushed button">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="0.97"/>
	<attnum name="blue" val="0.92"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Platinum silver for normal button text -->
      <section name="enabled button">
	<attnum name="red" val="0.80"/>
	<attnum name="green" val="0.82"/>
	<attnum name="blue" val="0.88"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Dim steel gray for disabled button text -->
      <section name="disabled button">
	<attnum name="red" val="0.30"/>
	<attnum name="green" val="0.32"/>
	<attnum name="blue" val="0.38"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Dark scroll list background -->
      <section name="background scroll list">
	<attnum name="red" val="0.03"/>
	<attnum name="green" val="0.03"/>
	<attnum name="blue" val="0.06"/>
	<attnum name="alpha" val="0.65"/>
      </section>
      <!-- Platinum silver for list item text -->
      <section name="scroll list">
	<attnum name="red" val="0.80"/>
	<attnum name="green" val="0.82"/>
	<attnum name="blue" val="0.88"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Amber for selected item highlight background -->
      <section name="background selected scroll list">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="0.52"/>
	<attnum name="blue" val="0.0"/>
	<attnum name="alpha" val="0.72"/>
      </section>
      <!-- Pure white for selected list item text -->
      <section name="selected scroll list">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="1.0"/>
	<attnum name="blue" val="1.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Platinum label text -->
      <section name="label">
	<attnum name="red" val="0.88"/>
	<attnum name="green" val="0.90"/>
	<attnum name="blue" val="0.95"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Steel blue-gray for tooltip text -->
      <section name="tip">
	<attnum name="red" val="0.50"/>
	<attnum name="green" val="0.55"/>
	<attnum name="blue" val="0.68"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Amber primary cursor -->
      <section name="mouse 1">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="0.60"/>
	<attnum name="blue" val="0.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Dark amber cursor shadow -->
      <section name="mouse 2">
	<attnum name="red" val="0.40"/>
	<attnum name="green" val="0.22"/>
	<attnum name="blue" val="0.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Amber for help key labels -->
      <section name="help key">
	<attnum name="red" val="1.0"/>
	<attnum name="green" val="0.65"/>
	<attnum name="blue" val="0.0"/>
	<attnum name="alpha" val="1.0"/>
      </section>
      <!-- Platinum silver for help descriptions -->
      <section name="help description">
	<attnum name="red" val="0.70"/>
	<attnum name="green" val="0.75"/>
	<attnum name="blue" val="0.82"/>
	<attnum name="alpha" val="1.0"/>
      </section>
    </section>
  </section>

</params>
