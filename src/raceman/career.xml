<?xml version="1.0" encoding="UTF-8"?>
<!--
    file        : career.xml
    description : Career Series race manager - 8-round single-make championship.
                  The player competes against a fixed grid of AI opponents across
                  8 varied road circuits.  Points are awarded to the top 8 finishers
                  after each race.
-->

